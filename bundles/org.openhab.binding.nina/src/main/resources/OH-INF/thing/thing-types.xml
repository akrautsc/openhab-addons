<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="nina"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- Sample Thing Type -->
	<thing-type id="nina">
		<label>Nina Binding Thing</label>
		<description>Sample thing for Nina Binding</description>

		<channels>
			<channel id="headline" typeId="headline"/><!-- Taken from ARSOverviewResult -->
			<channel id="description" typeId="description"/><!-- Taken from Warning -->
			<channel id="msgType" typeId="msgType"/><!-- Taken from ARSOverviewResult -->
			<channel id="severity" typeId="severity"/><!-- Taken from ARSOverviewResult -->
			<channel id="urgency" typeId="urgency"/><!-- Taken from Warning -->
			<channel id="provider" typeId="provider"/><!-- Taken from ARSOverviewResult -->
			<channel id="event" typeId="event"/><!-- Taken from Warning -->
			<channel id="sent" typeId="sent"/><!-- Taken from ARSOverviewResult -->
			<!-- Advanced channels -->
			<channel id="version" typeId="version"/><!-- Taken from ARSOverviewResult -->
			<channel id="category" typeId="category"/><!-- Taken from Warning -->
			<channel id="sender" typeId="sender"/><!-- Taken from Warning -->
			<channel id="status" typeId="status"/><!-- Taken from Warning -->
			<channel id="scope" typeId="scope"/><!-- Taken from Warning -->
			<channel id="identifier" typeId="identifier"/><!-- Taken from Warning -->
			<channel id="certainty" typeId="certainty"/><!-- Taken from Warning -->
		</channels>

		<config-description>
			<parameter name="ars" type="text" pattern="[0-9]{5}0{7}" required="true">
				<label>ARS</label>
				<description>Amtlicher Regionalschlüssel - kann z.B. von
					[hier](https://www.xrepository.de/api/xrepository/urn:de:bund:destatis:bevoelkerungsstatistik:schluessel:rs_2021-07-31/download/Regionalschl_ssel_2021-07-31.json)
					bezogen werden.
					Die Letzten 7 Stellen müssen dabei mit
					"0000000" ersetzt werden,
					weil die Daten nur auf Kreisebene
					bereitgestellt werden.
				</description>
			</parameter>
			<parameter name="serverUrl" type="text" required="true">
				<context>network-address</context>
				<label>Server URL</label>
				<description>URL of the Nina API</description>
				<default>https://warnung.bund.de/api31</default>
				<advanced>true</advanced>
			</parameter>
			<parameter name="refreshInterval" type="integer" required="true">
				<label>Refresh Interval</label>
				<description>Interval the device is polled in sec.</description>
				<default>60</default>
				<advanced>true</advanced>
			</parameter>
		</config-description>
	</thing-type>


	<!-- Custom Channel Types -->
	<channel-type id="version" advanced="true">
		<item-type>Number</item-type>
		<label>Version</label>
		<description>Version of warning.</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="type">
		<item-type>String</item-type>
		<label>type</label>
		<description>Warning type.</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="headline">
		<item-type>String</item-type>
		<label>Headline</label>
		<description>Warning headline</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="description">
		<item-type>String</item-type>
		<label>Description</label>
		<description>Warning description</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="provider">
		<item-type>String</item-type>
		<label>Provider</label>
		<description>Warning provider</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="severity">
		<item-type>String</item-type>
		<label>Severity</label>
		<description>Warning severity</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="msgType">
		<item-type>String</item-type>
		<label>Message Type</label>
		<description>Message type of warning.</description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="identifier" advanced="true">
		<item-type>String</item-type>
		<label>Identifier</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="sender" advanced="true">
		<item-type>String</item-type>
		<label>Sender</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="sent">
		<item-type>DateTime</item-type>
		<label>Sent</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="status" advanced="true">
		<item-type>String</item-type>
		<label>Status</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="scope" advanced="true">
		<item-type>String</item-type>
		<label>Scope</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="category" advanced="true">
		<item-type>String</item-type>
		<label>Category</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="event">
		<item-type>String</item-type>
		<label>Event</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="urgency">
		<item-type>String</item-type>
		<label>Urgency</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="certainty" advanced="true">
		<item-type>String</item-type>
		<label>Certainty</label>
		<description></description>
		<state readOnly="true"/>
	</channel-type>
	<channel-type id="TEST">
		<item-type>String</item-type>
		<label>TEST</label>
		<description>TEST</description>
		<state readOnly="true"/>
	</channel-type>
</thing:thing-descriptions>
